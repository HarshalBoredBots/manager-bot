# ═══════════════════════════════════════════════════════════════
# Manager Bot — Environment Variables
# Copy to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════

# ── Telegram API credentials (my.telegram.org) ───────────────
API_ID=
API_HASH=

# ── Manager Bot Token (from @BotFather) ──────────────────────
BOT_TOKEN=

# ── Shared String Session ────────────────────────────────────
# Used ONLY for reading/writing protocol messages in the
# Worker Control Group.  NEVER for downloading or uploading files.
# Generate with: python -c "from pyrogram import Client; Client('s', api_id=..., api_hash='...').run()"
STRING_SESSION=

# ── Channels / Groups ────────────────────────────────────────
# Worker Control Group — all bots (Manager + Workers) must be members
WORKER_CONTROL_GROUP_ID=

# Channel where Workers upload completed files (before Manager copies to user)
WORKER_OUTPUT_CHANNEL_ID=

# Central dump channel for the rich FILE INFO log (optional)
CENTRAL_DUMP_CHANNEL_ID=

# Manager logs new users / startup events here (optional)
LOG_CHANNEL=

# ── Database ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=DistributedRenameBot

# ── Owners (space or comma-separated Telegram user IDs) ──────
OWNER_IDS=6672752177 1828405916

# ── Worker health settings ───────────────────────────────────
WORKER_OFFLINE_TIMEOUT=120
JOB_LEASE_SECONDS=300

# ── ImgBB (thumbnail cross-worker sharing) ───────────────────
# Get a free API key at https://api.imgbb.com/
# Without this, thumbnail support is disabled.
IMGBB_API_KEY=

# ── Health check (Koyeb/Render keep-alive) ───────────────────
PORT=8000

# ── UI ───────────────────────────────────────────────────────
START_PIC=
SETTINGS_IMAGE=

# ── Bot upload limits ────────────────────────────────────────
BOT_MAX_SIZE=2000000000
